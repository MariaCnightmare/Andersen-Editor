{
  "name": "andersen-editor",
  "private": true,
  "version": "0.0.2",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5173",
    "start:electron": "npx electron src/main/main.cjs",
    "dev:electron": "npx electron src/main/main.cjs",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0 --port 5173",
    "prebuild": "cmd /d /s /c \"\"C:\\Program Files\\Git\\bin\\bash.exe\" ./tools/sync_vendor_assets.sh\"",
    "dist:appx": "npm run build && electron-builder --win appx --x64"
  },
  "devDependencies": {
    "electron": "^40.4.1",
    "electron-builder": "^26.7.0",
    "vite": "^6.0.0"
  },
  "dependencies": {
    "codemirror": "^5.65.16",
    "mermaid": "^10.9.1"
  },
  "main": "src/main/main.cjs",
  "build": {
    "directories": {
      "buildResources": "build",
      "output": "release/appx"
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "appx"
      ]
    },
    "appId": "Mujyo.Andersen-Editor",
    "productName": "Andersen-Editor",
    "appx": {
      "identityName": "Mujyo.Andersen-Editor",
      "publisher": "CN=B8154378-D196-4FA1-AEE3-B19374511F0E",
      "publisherDisplayName": "Mujyo",
      "applicationId": "AndersenEditor",
      "displayName": "Andersen-Editor",
      "backgroundColor": "#0b0f14"
    },
    "files": [
      "dist/**",
      "src/main/**",
      "src/renderer/public/**",
      "package.json"
    ],
    "icon": "build/icon.png"
  }
}
