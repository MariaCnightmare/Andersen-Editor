{
  "themeId": "infra-light",
  "name": "Infra Light",
  "mode": "light",
  "init": {
    "theme": "default",
    "flowchart": {
      "curve": "basis"
    }
  },
  "vars": {
    "--surface-0": "#f5f7fb",
    "--surface-1": "#ffffff",
    "--surface-2": "#f2f5fb",
    "--panel": "#ffffff",
    "--panel2": "#f2f5fb",
    "--text": "#121826",
    "--text-1": "#0f172a",
    "--text-2": "#334155",
    "--text-3": "#64748b",
    "--muted": "#64748b",
    "--border": "rgba(15,23,42,.16)",
    "--border-1": "rgba(15,23,42,.16)",
    "--border-2": "rgba(15,23,42,.28)",
    "--border-3": "rgba(36,91,219,.55)",
    "--accent": "#245bdb",
    "--accent-1": "#245bdb",
    "--accent2": "#b07b00",
    "--btn": "#e8edf8",
    "--btnHover": "#dbe4f4",
    "--input": "#ffffff",
    "--danger": "#d33a3a",
    "--ok": "#0a8a53",
    "--shadow-1": "0 8px 18px rgba(15,23,42,.10)",
    "--shadow-2": "0 12px 24px rgba(15,23,42,.14)",
    "--t-fast": "140ms"
  },
  "classDefs": {
    "role-client": "fill:#e9f1ff,stroke:#245bdb,stroke-width:2px,color:#121826",
    "role-internet": "fill:#f2e9ff,stroke:#6b3fd6,stroke-width:2px,color:#121826",
    "role-server": "fill:#eef2ff,stroke:#245bdb,stroke-width:2px,color:#121826",
    "role-app": "fill:#e9fff2,stroke:#0a8a53,stroke-width:2px,color:#121826",
    "role-lb": "fill:#fff6e3,stroke:#b07b00,stroke-width:2px,color:#121826",
    "role-db": "fill:#f4edff,stroke:#6b3fd6,stroke-width:2px,color:#121826",
    "role-vpn": "fill:#fff3e9,stroke:#b07b00,stroke-width:2px,color:#121826",
    "role-fw": "fill:#ffe9e9,stroke:#d33a3a,stroke-width:2px,color:#121826",
    "role-router": "fill:#f0ffe9,stroke:#3d8a0a,stroke-width:2px,color:#121826",
    "role-external": "fill:#ffffff,stroke:#5a657a,stroke-width:2px,color:#121826",
    "accent-blue": "fill:#e8f4ff,stroke:#245bdb,stroke-width:2px,color:#121826",
    "accent-green": "fill:#e9fff2,stroke:#0a8a53,stroke-width:2px,color:#121826",
    "accent-amber": "fill:#fff6e3,stroke:#b07b00,stroke-width:2px,color:#121826",
    "accent-red": "fill:#ffe9e9,stroke:#d33a3a,stroke-width:2px,color:#121826"
  },
  "boundaryStyles": {
    "boundary-onprem": "fill:transparent,stroke:#5a657a,stroke-width:1px,stroke-dasharray:4 4,color:#5a657a",
    "boundary-vpc": "fill:transparent,stroke:#245bdb,stroke-width:1px,stroke-dasharray:4 4,color:#245bdb",
    "boundary-subnet": "fill:transparent,stroke:#0a8a53,stroke-width:1px,stroke-dasharray:4 4,color:#0a8a53",
    "boundary-dmz": "fill:transparent,stroke:#b07b00,stroke-width:1px,stroke-dasharray:4 4,color:#b07b00"
  },
  "edgeStyles": {
    "edge-http": "stroke:#245bdb,stroke-width:2px",
    "edge-sql": "stroke:#6b3fd6,stroke-width:2px",
    "edge-dep": "stroke:#5a657a,stroke-width:2px,stroke-dasharray:4 4",
    "edge-opt": "stroke:#5a657a,stroke-width:1px,stroke-dasharray:2 6",
    "edge-tunnel": "stroke:#b07b00,stroke-width:4px,stroke-dasharray:6 4"
  }
}
