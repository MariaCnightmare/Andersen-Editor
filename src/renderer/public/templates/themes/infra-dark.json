{
  "themeId": "infra-dark",
  "name": "Infra Dark",
  "mode": "dark",
  "init": {
    "theme": "dark",
    "flowchart": {
      "curve": "basis"
    }
  },
  "vars": {
    "--surface-0": "#060910",
    "--surface-1": "#0a111a",
    "--surface-2": "#0b141f",
    "--panel": "#0a111a",
    "--panel2": "#0b141f",
    "--text": "#eef4ff",
    "--text-1": "#f6f9ff",
    "--text-2": "#dce7f9",
    "--text-3": "#a0b2cc",
    "--muted": "#a0b2cc",
    "--border": "rgba(255,255,255,.08)",
    "--border-1": "rgba(255,255,255,.10)",
    "--border-2": "rgba(255,255,255,.18)",
    "--border-3": "rgba(79,212,255,.60)",
    "--accent": "#4fd4ff",
    "--accent-1": "#4fd4ff",
    "--accent2": "#ffc266",
    "--btn": "#0f1b2a",
    "--btnHover": "#18304a",
    "--input": "#0b1522",
    "--danger": "#ff6b6b",
    "--ok": "#6bffb5",
    "--shadow-1": "0 10px 24px rgba(0,0,0,.40)",
    "--shadow-2": "0 16px 30px rgba(0,0,0,.35)",
    "--t-fast": "140ms"
  },
  "classDefs": {
    "role-client": "fill:#1b2b45,stroke:#7fb2ff,stroke-width:2px,color:#e6eefc",
    "role-internet": "fill:#2a223a,stroke:#c9a7ff,stroke-width:2px,color:#e6eefc",
    "role-server": "fill:#1f2a44,stroke:#7fb2ff,stroke-width:2px,color:#e6eefc",
    "role-app": "fill:#1b3a2f,stroke:#6bffb5,stroke-width:2px,color:#e6eefc",
    "role-lb": "fill:#2f2b1b,stroke:#ffd36b,stroke-width:2px,color:#e6eefc",
    "role-db": "fill:#2b213f,stroke:#c9a7ff,stroke-width:2px,color:#e6eefc",
    "role-vpn": "fill:#3a2b1b,stroke:#ffd36b,stroke-width:2px,color:#e6eefc",
    "role-fw": "fill:#3a1b1b,stroke:#ff6b6b,stroke-width:2px,color:#e6eefc",
    "role-router": "fill:#233a1b,stroke:#b6ff6b,stroke-width:2px,color:#e6eefc",
    "role-external": "fill:#202020,stroke:#a7b4cf,stroke-width:2px,color:#e6eefc",
    "accent-blue": "fill:#122338,stroke:#4fd4ff,stroke-width:2px,color:#e6eefc",
    "accent-green": "fill:#132b22,stroke:#6bffb5,stroke-width:2px,color:#e6eefc",
    "accent-amber": "fill:#2f2b1b,stroke:#ffd36b,stroke-width:2px,color:#e6eefc",
    "accent-red": "fill:#3a1b1b,stroke:#ff6b6b,stroke-width:2px,color:#e6eefc"
