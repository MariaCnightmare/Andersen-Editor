  "boundaryStyles": {
    "boundary-onprem": "fill:transparent,stroke:#a7b4cf,stroke-width:1px,stroke-dasharray:4 4,color:#a7b4cf",
    "boundary-vpc": "fill:transparent,stroke:#7fb2ff,stroke-width:1px,stroke-dasharray:4 4,color:#7fb2ff",
    "boundary-subnet": "fill:transparent,stroke:#6bffb5,stroke-width:1px,stroke-dasharray:4 4,color:#6bffb5",
    "boundary-dmz": "fill:transparent,stroke:#ffd36b,stroke-width:1px,stroke-dasharray:4 4,color:#ffd36b"
  },
  "edgeStyles": {
    "edge-http": "stroke:#7fb2ff,stroke-width:2px",
    "edge-sql": "stroke:#c9a7ff,stroke-width:2px",
    "edge-dep": "stroke:#a7b4cf,stroke-width:2px,stroke-dasharray:4 4",
    "edge-opt": "stroke:#a7b4cf,stroke-width:1px,stroke-dasharray:2 6",
    "edge-tunnel": "stroke:#ffd36b,stroke-width:4px,stroke-dasharray:6 4"
  }
